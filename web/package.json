{
  "name": "women-count-map",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "prepare:palette": "python theme.py",
    "prepare:data": "python scripts/prepare_data.py",
    "test:data": "python -m unittest discover -s scripts -p test_*.py",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "d3-geo": "^3.1.1",
    "leaflet": "^1.9.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-leaflet": "^5.0.0",
    "supercluster": "^9.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/d3-geo": "^3.1.0",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "typescript": "~5.9.3",
    "vite": "^7.2.0"
  }
}
